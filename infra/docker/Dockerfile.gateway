FROM node:22-alpine AS builder

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
COPY apps/gateway ./apps/gateway

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter=@agentforge/protocol run build
RUN pnpm --filter=@agentforge/database run build
RUN pnpm --filter=@agentforge/security run build
RUN pnpm --filter=@agentforge/ai-router run build
RUN pnpm --filter=@agentforge/tool-sdk run build
RUN pnpm --filter=@agentforge/agent-core run build
RUN pnpm --filter=@agentforge/gateway run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./

EXPOSE 3000
CMD ["node", "apps/gateway/dist/index.js"]
