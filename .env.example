# AI Studio Environment Configuration
# Android Secrets
GEMINI_API_KEY="placeholder"

# Backend Services Configuration
PORT=3000
GATEWAY_PORT=3000
RUNTIME_PORT=3001
COMPUTER_WORKER_PORT=3002
NODE_ENV=development

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentforge?schema=public
REDIS_URL=redis://localhost:6379

# Security & Tokens
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-minimum-32-chars-change-in-prod
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM Providers
OPENAI_API_KEY="placeholder"
ANTHROPIC_API_KEY="placeholder"
GOOGLE_AI_API_KEY="placeholder"
XAI_API_KEY="placeholder"
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentforge-files
S3_REGION=us-east-1

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=agentforge-app
FCM_CLIENT_EMAIL="placeholder"
FCM_PRIVATE_KEY="placeholder"
