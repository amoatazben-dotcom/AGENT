# ============================================================
# AgentForge Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
# ============================================================

# ---- AI Provider API Keys ----
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-google-gemini-api-key>

# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Get your key from: https://console.x.ai/
XAI_API_KEY=<your-xai-grok-api-key>

# ---- Android / Mobile ----
# Same Gemini key as above, used by the Android app
# GEMINI_API_KEY is shared — already defined above

# ---- Backend Server Ports ----
GATEWAY_PORT=3000
RUNTIME_PORT=3001
COMPUTER_WORKER_PORT=3002
NODE_ENV=development

# ---- CORS Allowed Origins (comma-separated) ----
# In production set this to your frontend domain(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Local-first storage (DEFAULT, no server needed) ----
# Gateway persists to a local SQLite file. No PostgreSQL required.
AGENTFORGE_DATA_DIR=./data
# AGENTFORGE_DB_PATH=./data/agentforge.db
# Workspace files (sandbox root for tool execution)
# WORKSPACE_DIR=./data/workspace
# Computer worker URL (optional; computer features report "unavailable" when offline)
# COMPUTER_WORKER_URL=http://localhost:3002

# ---- Database (OPTIONAL production path) ----
# PostgreSQL via Prisma remains available for hosted deployments.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentforge?schema=public

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=<generate-a-64-char-hex-string>

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-96-char-hex-string>

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_REFRESH_SECRET=<generate-another-96-char-hex-string>

# ---- Optional: Local AI (Ollama) ----
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
