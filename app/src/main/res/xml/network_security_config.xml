<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration
    Production: cleartext (HTTP) is FORBIDDEN globally.
    Exception: loopback + emulator alias + link-local for local AI/Gateway dev.
    LAN (192.168.x.x / 10.x) HTTP is intentionally NOT whitelisted: the app
    shows an explicit warning when a provider/gateway uses unencrypted HTTP
    outside localhost. Use HTTPS for anything beyond this device.
    Copyright © 2025 Moataz Al-Alqami — Taiz, Yemen
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Loopback only: device-local Gateway / Ollama / LM Studio over HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="false">[::1]</domain>
    </domain-config>
</network-security-config>
